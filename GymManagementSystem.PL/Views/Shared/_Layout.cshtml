@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Baloo+Thambi+2:wght@400..800&family=Rubik:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <title>@ViewData["Title"] - Power Fitness</title>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-white my-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.jpg" alt="Power Fitness" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @Active("Home") px-3 py-2 mx-2 fw-bolder fs-5" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @Active("Members") px-3 py-2 mx-2 fw-bolder fs-5" asp-controller="Members" asp-action="Index">Members</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link @Active("Trainers") px-3 py-2 mx-2 fw-bolder fs-5" asp-controller="Trainers" asp-action="Index">Trainers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Sessions") px-3 py-2 mx-2 fw-bolder fs-5" asp-controller="Sessions" asp-action="Index">Sessions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Active("Plans") px-3 py-2 mx-2 fw-bolder fs-5" asp-controller="Plans" asp-action="Index">Plans</a>
                        </li>
                    </ul>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex ms-lg-3">
                        <button type="submit" class="btn btn-outline"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    </form>
                    }
                </div>
            </div>
        </nav>
    </header>

    <partial name="_Alerts" />

    @RenderBody()

    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const alertBox = document.getElementById("Alert");
            if (alertBox) {
                setTimeout(() => {
                    alertBox.style.transition = "opacity 0.5s ease";
                    alertBox.style.opacity = "0";
                    setTimeout(() => alertBox.remove(), 500);
                }, 2500);
            }
        });
    </script>
</body>
</html>
