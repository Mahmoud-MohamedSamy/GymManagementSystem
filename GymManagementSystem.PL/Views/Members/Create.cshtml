@model CreateMemberViewModel
@{
    ViewData["Title"] = "Add Member";
}

<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">Add New Member</h3>
    </header>

    <form asp-controller="Members" asp-action="CreateMember" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <ul class="nav nav-tabs mb-4" id="addMemberTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="member-tab" data-bs-toggle="tab" data-bs-target="#member-info" type="button" role="tab">Member Info</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="health-tab" data-bs-toggle="tab" data-bs-target="#health-info" type="button" role="tab">Health Data</button>
            </li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane fade show active" id="member-info" role="tabpanel" aria-labelledby="member-tab">
                <div class="section-header mb-3">
                    <h5 class="text-primary fw-bold">Personal Information</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="DateOfBirth" class="form-label">Date Of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Gender" class="form-label">Gender</label>
                        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Photo" class="form-label">Photo</label>
                        <input asp-for="Photo" type="file" accept=".jpg,.jpeg,.png" class="form-control" />
                        <small class="text-muted">JPG or PNG, max 5 MB</small>
                        <span asp-validation-for="Photo" class="text-danger d-block"></span>
                    </div>
                </div>

                <div class="section-header mb-3 mt-4">
                    <h5 class="text-primary fw-bold">Address Information</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="BuildingNumber" class="form-label">Building Number</label>
                        <input asp-for="BuildingNumber" class="form-control" />
                        <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Street" class="form-label">Street</label>
                        <input asp-for="Street" class="form-control" />
                        <span asp-validation-for="Street" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label">City</label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="tab-pane fade" id="health-info" role="tabpanel" aria-labelledby="health-tab">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecordViewModel.Height" class="form-label">Height (cm)</label>
                        <input asp-for="HealthRecordViewModel.Height" class="form-control" />
                        <span asp-validation-for="HealthRecordViewModel.Height" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecordViewModel.Weight" class="form-label">Weight (kg)</label>
                        <input asp-for="HealthRecordViewModel.Weight" class="form-control" />
                        <span asp-validation-for="HealthRecordViewModel.Weight" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecordViewModel.BloodType" class="form-label">Blood Type</label>
                        <select asp-for="HealthRecordViewModel.BloodType" class="form-select">
                            <option value="">Select</option>
                            <option>A+</option>
                            <option>A-</option>
                            <option>B+</option>
                            <option>B-</option>
                            <option>O+</option>
                            <option>O-</option>
                            <option>AB+</option>
                            <option>AB-</option>
                        </select>
                        <span asp-validation-for="HealthRecordViewModel.BloodType" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="HealthRecordViewModel.Note" class="form-label">Note</label>
                        <input asp-for="HealthRecordViewModel.Note" class="form-control" />
                        <span asp-validation-for="HealthRecordViewModel.Note" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <footer class="d-flex justify-content-between mt-4">
            <a asp-controller="Members" asp-action="Index" class="btn btn-outline">Cancel</a>
            <button type="submit" class="btn btn-fill">Add</button>
        </footer>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
